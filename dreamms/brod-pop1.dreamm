//
// Prince of Persia
//
desc[brod-pop1]:

name = Prince of Persia
icon = brod-pop1.png
machine = pc
osenv = dos
rootpath = C:\PRINCE
launch = $(rootpath)\PRINCE.EXE $(VIDEO) $(AUDIO)
mips = $(MIPS_286_10)
ramkb = 640
filter = broderbund, platformer, action
TANDY = 0
NEWVIDEOCFG = 0x05
NEWSOUNDCFG = 0x00

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[tandy]: 
        name = $(TVIDEO_NAME)
        videohw = cga; audiohw = speaker; machine = tandy
        VIDEO = tga; TANDY = 1
        AUDIO = tandy
        NEWVIDEOCFG = 0x03
        NEWSOUNDCFG = 0x07
        NEWMUSICCFG = 0x07
        condition = file_exists("$$(rootpath)\\CDUNGEON.DAT")
    end
    option[hercules]: 
        name = $(HERCULES_NAME)
        videohw = hercules
        VIDEO = herc
        NEWVIDEOCFG = 0x02
        condition = file_exists("$$(rootpath)\\CDUNGEON.DAT")
    end
    option[cga]:  
        name = $(CGA_NAME)
        videohw = cga
        VIDEO = cga
        NEWVIDEOCFG = 0x01
        condition = file_exists("$$(rootpath)\\CDUNGEON.DAT")
    end
    option[ega]:
        name = $(EGA_NAME)
        videohw = ega
        VIDEO = ega
        NEWVIDEOCFG = 0x04
        condition = file_exists("$$(rootpath)\\EDUNGEON.DAT")
    end
    option[mcga]:     
        name = $(MCGA_NAME)
        videohw = mcga
        VIDEO = mcga
        NEWVIDEOCFG = 0x05
    end
    option[vga]:     
        name = $(VGA_NAME)
        videohw = vga; priority = 1
        VIDEO = vga
        NEWVIDEOCFG = 0x05
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    condition = !$(TANDY)
    option[speaker]:
        name = $(SPEAKER_NAME)
        audiohw = speaker
        AUDIO = stdsnd
        NEWSOUNDCFG = 0x00
        NEWMUSICCFG = 0x00
        14SOUNDCFG = 0xFF 0xFF 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xFE 0xFF 0xFE 0xFF 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x01 0x00 0x00 0x00
        14SETUP = 0x00 0x00 0x01 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0xFE 0xFF 0xFE 0xFF 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x01 0x00 0x00 0x00
    end
    option[cms]:
        name = $(CMS_NAME)
        audiohw = cms
        AUDIO = gblast
        condition = file_exists("$$(rootpath)\\EDUNGEON.DAT")
    end
    option[adlib]:
        name = $(ADLIB_NAME)
        audiohw = adlib
        AUDIO = adlib
        NEWSOUNDCFG = 0x01
        NEWMUSICCFG = 0x01
        condition = file_exists("$$(rootpath)\\EDUNGEON.DAT")
    end
    option[sb16]:
        name = $(SB16_NAME)
        audiohw = sb16; priority = 1
        AUDIO = sblast
        NEWSOUNDCFG = 0x03
        NEWMUSICCFG = 0x03
        14SOUNDCFG = 0xFF 0xFF 0x00 0x00 0x00 0x00 0x01 0x00 0x21 0x00 0xFE 0xFF 0xFE 0xFF 0x20 0x02 0xFF 0xFF 0x01 0x00 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0x01 0x00 0x01 0x00 0x00 0x00
    end
    option[gmidi]:
        name = $(GMIDI_NAME)
        audiohw = gmidi
        AUDIO = midi
        condition = file_exists("$$(rootpath)\\EDUNGEON.DAT")
    end
    option[mt32+sb16]:
        name = Roland MT-32 plus SoundBlaster
        audiohw = mt32+sb16
        NEWSOUNDCFG = 0x03
        NEWMUSICCFG = 0x06
        condition = file_exists("$$(rootpath)\\MT32SND1.DAT")
        condition = file_exists("$$(rootpath)\\MT32SND2.DAT")
    end
    option[mt32]:
        name = Roland MT-32
        audiohw = mt32
        NEWSOUNDCFG = 0x06
        NEWMUSICCFG = 0x06
        condition = file_exists("$$(rootpath)\\MT32SND1.DAT")
        condition = file_exists("$$(rootpath)\\MT32SND2.DAT")
    end
end

dynamicfile[]:
    condition = file_exists("$$(rootpath)\\CONFIG.DAT")
    condition = file_exists("$$(rootpath)\\INSTALL.PDM")
    path = $(rootpath)\CONFIG.DAT
    contents = [[[
        [[BINARY:$(NEWVIDEOCFG) 0x00 0x00 0x00 0xFF 0xFF $(NEWSOUNDCFG) 0x00 $(NEWMUSICCFG) 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x01 0x00 0x00 0x00]]
    ]]]
end

dynamicfile[]:
    condition = file_exists("$$(rootpath)\\DIGI.DRV")
    path = $(rootpath)\CONFIG.DAT
    contents = [[[
        [[BINARY:$(14SOUNDCFG)]]
    ]]]
end

dynamicfile[]:
    condition = file_exists("$$(rootpath)\\DIGI.DRV")
    path = $(rootpath)\SETUP.DAT
    contents = [[[
        [[BINARY:$(14SETUP)]]
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// Demo
//
